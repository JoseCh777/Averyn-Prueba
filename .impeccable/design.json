  "narrative": {
    "northStar": "El horizonte que se oscurece",
    "overview": "Averyn abre con un cielo claro y, a medida que se avanza, el fondo cae hacia un navy profundo: la claridad de la plataforma se convierte en seguridad. Sobre ese horizonte, un trazo fino de arcos hace de firma. Sistema sereno e institucional, con la precisión de un instrumento.",
    "keyCharacteristics": [
      "Fondo de cielo a navy como gesto central; el logo negro vive en la zona clara.",
      "Un solo azul de señal; el cian es trazo o resalte, nunca superficie grande.",
      "Acciones en JetBrains Mono mayúsculas; titulares en Space Grotesk 500.",
      "Líneas de 1 px y espacio en blanco en lugar de cajas; sombra solo en el marco del login y en los botones.",
      "Espacios reservados para imágenes y video futuros."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "El azul de señal es el único color que invita a actuar; el cian nunca es superficie.",
        "section": "colors"
      },
      {
        "name": "The Horizon Rule",
        "body": "El oscurecimiento va de arriba (claro) hacia abajo (navy); el logo negro siempre se apoya en la zona clara.",
        "section": "colors"
      },
      {
        "name": "The Mono Action Rule",
        "body": "Lo que se pulsa o rotula va en JetBrains Mono mayúsculas; lo que se lee, en Inter o Space Grotesk.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Una superficie en reposo no tiene sombra; solo botones, el marco del login y popovers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do mantener el logo negro sobre la zona clara del degradado y el blanco sobre navy.",
      "Do separar con líneas de 1 px y espacio en blanco antes que con tarjetas.",
      "Do usar JetBrains Mono mayúsculas para botones, rótulos y navegación.",
      "Do respetar prefers-reduced-motion.",
      "Do componer de forma asimétrica."
    ],
    "donts": [
      "Don't usar el cian como superficie grande ni el azul de señal como decoración.",
      "Don't añadir sombras difusas, glows de color ni franjas laterales gruesas.",
      "Don't volver al estilo brutalista: se probó y se descartó por perder identidad.",
      "Don't centrar y repetir tres tarjetas iguales como solución por defecto.",
      "Don't ampliar el wordmark por encima de su tamaño nativo."
    ]
  }
